# Public port on the Docker host
ZEROTTS_PORT=8000

# Leave empty to disable authentication. Set a secret for exposed deployments.
ZEROTTS_API_KEY=change-me

ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
ZEROTTS_DEVICE_ID=0
ZEROTTS_MAX_CONCURRENCY=1
ZEROTTS_INTRA_OP_THREADS=4
ZEROTTS_NORMALIZE_VI=true

# Kokoro ONNX handles its supported non-Vietnamese languages. Model assets are
# downloaded once into the persistent kokoro-model-cache volume.
KOKORO_ENABLED=true
KOKORO_DOWNLOAD=true

# Misaki is primary. Keep this enabled only for Kokoro languages for which
# Misaki has no native frontend yet (es, fr, hi, it, pt-BR).
KOKORO_ESPEAK_FALLBACK=true

# Optional aliases must point to a canonical voice. Example:
# {"narrator":"vf_maichi","english-narrator":"af_heart","alloy":"vf_maichi"}
TTS_VOICE_ALIASES={}
